{
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "1000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/keep-working.js",
              "--init"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/keep-working.js"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}